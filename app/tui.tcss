/* Orbital Intelligence System - Minimalist Terminal Stylesheet
   Crafted with a premium deep purple & golden-yellow cosmic palette.
*/

Screen {
    background: #08060f;
    color: #d1c9e8;
}

/* --------------------------------------------------------------------------
   Themes
   -------------------------------------------------------------------------- */

Screen.-theme-minimal-dark {
    background: #08060f;
    color: #d1c9e8;
}

Screen.-theme-cyberpunk {
    background: #060510;
    color: #e2e8f0;
}
Screen.-theme-cyberpunk #top-status-bar {
    background: #0c081e;
    border-bottom: solid #9d174d;
}
Screen.-theme-cyberpunk #top-title {
    color: #f43f5e;
}
Screen.-theme-cyberpunk Tab.-active {
    color: #f43f5e;
    border-bottom: solid #f43f5e;
}
Screen.-theme-cyberpunk Button:focus {
    background: #be185d;
    color: #ffffff;
}

Screen.-theme-nord {
    background: #242933;
    color: #d8dee9;
}
Screen.-theme-nord #top-status-bar {
    background: #2e3440;
    border-bottom: solid #434c5e;
}
Screen.-theme-nord #top-title {
    color: #88c0d0;
}
Screen.-theme-nord Tab.-active {
    color: #88c0d0;
    border-bottom: solid #88c0d0;
}
Screen.-theme-nord Button:focus {
    background: #5e81ac;
    color: #eceff4;
}

Screen.-theme-matrix {
    background: #020a04;
    color: #4ade80;
}
Screen.-theme-matrix #top-status-bar {
    background: #041408;
    border-bottom: solid #166534;
}
Screen.-theme-matrix #top-title {
    color: #22c55e;
}
Screen.-theme-matrix Tab.-active {
    color: #22c55e;
    border-bottom: solid #22c55e;
}
Screen.-theme-matrix Button:focus {
    background: #15803d;
    color: #ffffff;
}

/* --------------------------------------------------------------------------
   Top Status Bar (Clean 1-row header, no bulky title bar)
   -------------------------------------------------------------------------- */

#top-status-bar {
    dock: top;
    height: 1;
    min-height: 1;
    background: #08060f;
    border-bottom: solid #2c214c;
    padding: 0 1;
    align: left middle;
}

#top-nav-btn {
    height: 1;
    min-height: 1;
    min-width: 6;
    padding: 0 1;
    margin-right: 1;
    border: none;
    background: transparent;
    color: #c084fc;
}

#top-nav-btn:hover {
    background: #2c214c;
    color: #facc15;
}

#top-title {
    color: #facc15;
    text-style: bold;
    width: auto;
    margin-right: 2;
}

#db-status-badge {
    color: #facc15;
    width: auto;
    margin-right: 2;
}

#top-stats-summary {
    color: #756999;
    text-align: right;
    width: 1fr;
}

/* --------------------------------------------------------------------------
   Footer
   -------------------------------------------------------------------------- */

Footer {
    dock: bottom;
    height: 1;
    min-height: 1;
    background: #08060f;
    border-top: solid #2c214c;
    color: #756999;
}

/* --------------------------------------------------------------------------
   Minimalist Buttons Everywhere
   -------------------------------------------------------------------------- */

Button {
    height: 1;
    min-height: 1;
    min-width: 4;
    padding: 0 1;
    margin: 0;
    border: none;
    background: #18122c;
    color: #d1c9e8;
}

Button:hover {
    background: #2a1f4a;
    color: #fde047;
}

Button:focus {
    background: #7c3aed;
    color: #fde047;
    text-style: bold;
}

/* --------------------------------------------------------------------------
   Home View: Art beside the OSIS menu
   -------------------------------------------------------------------------- */

#home-view-container {
    height: 1fr;
    align: center middle;
    overflow-y: auto;
    padding: 1;
}

#home-content-row {
    width: auto;
    height: auto;
    align: center middle;
}

#home-art-box {
    width: 76;
    height: auto;
    border: solid #9333ea;
    background: #0d0a1b;
    padding: 0 1;
    align: center middle;
    margin-right: 2;
}

#home-art-content {
    width: 1fr;
    height: auto;
}

#home-menu-box {
    width: 68;
    height: auto;
    border: solid #2c214c;
    border-title-align: center;
    border-title-color: #c084fc;
    border-title-style: bold;
    background: #0d0a1b;
    padding: 1 2;
    align: left middle;
}

#home-menu-title {
    width: 100%;
    height: 7;
    content-align: center middle;
    border-bottom: solid #2c214c;
    margin-bottom: 1;
}

#home-menu-subtitle {
    width: 100%;
    text-align: center;
    color: #facc15;
    margin-bottom: 1;
}

.home-menu-btn {
    width: 100%;
    height: 1;
    min-height: 1;
    margin-bottom: 1;
    border: none;
    background: #18122c;
    color: #d1c9e8;
    text-align: left;
    content-align: left middle;
    padding: 0 1;
}

.home-menu-btn:hover {
    background: #2a1f4a;
    color: #fde047;
}

#home-menu-hint {
    text-align: center;
    color: #756999;
    margin-top: 0;
}

/* --------------------------------------------------------------------------
   Dashboard & Tabs
   -------------------------------------------------------------------------- */

#dashboard-view-container {
    height: 1fr;
}

#dashboard-ascii-title, #shell-ascii-title, #settings-ascii-title {
    height: 5;
    margin: 0 0 1 0;
    color: #facc15;
    text-style: bold;
}

#settings-ascii-title {
    margin-bottom: 0;
}

TabbedContent {
    height: 1fr;
}

Tabs {
    dock: top;
    height: 1;
    min-height: 1;
    background: #08060f;
    border-bottom: solid #2c214c;
    padding: 0;
    margin-bottom: 1;
}

Tab {
    height: 1;
    min-height: 1;
    padding: 0 1;
    border: none;
    background: transparent;
    color: #756999;
}

Tab:hover {
    color: #fde047;
}

Tab.-active {
    color: #facc15;
    text-style: bold;
    background: #16102c;
    border-bottom: solid #facc15;
}

TabPane {
    padding: 0 1;
    height: 1fr;
}

/* --------------------------------------------------------------------------
   Catalog Tab
   -------------------------------------------------------------------------- */

#catalog-filter-bar {
    height: 1;
    margin-bottom: 1;
    align: left middle;
}

#catalog-search {
    width: 24;
    height: 1;
    min-height: 1;
    margin-right: 1;
    border: none;
    background: #120e24;
    color: #ffffff;
    padding: 0 1;
}

#catalog-search:focus {
    background: #1c1538;
}

.filter-select {
    width: 22;
    height: 1;
    min-height: 1;
    margin-right: 1;
    border: none;
    background: #120e24;
    color: #d1c9e8;
    padding: 0 1;
}

#filter-operator {
    width: 28;
}

#select-sync-source {
    width: 44;
}

SelectCurrent {
    height: 1;
    min-height: 1;
    border: none;
    background: #120e24;
    padding: 0 1;
}

#btn-reset-filters {
    height: 1;
    min-width: 6;
    background: #18122c;
    color: #d1c9e8;
}

#btn-reset-filters:hover {
    color: #fde047;
}

#catalog-split-container {
    height: 1fr;
}

#catalog-left-column {
    width: 60%;
    height: 1fr;
    margin-right: 1;
}

#catalog-right-column {
    width: 40%;
    height: 1fr;
}

#catalog-table-box {
    width: 1fr;
    height: 1fr;
    border: solid #2c214c;
    background: #0b0818;
    padding: 0;
}

#schema-explorer-box {
    height: 1fr;
    min-height: 8;
    border: solid #2c214c;
    background: #0b0818;
    margin-top: 1;
    padding: 0 1;
}

#schema-explorer-title {
    height: 1;
    color: #facc15;
    text-style: bold;
}

#schema-explorer {
    height: 1fr;
    background: transparent;
    color: #d1c9e8;
}

#catalog-table-box:focus-within {
    border: solid #9333ea;
}

#satellite-detail-pane {
    height: 1fr;
    border: solid #2c214c;
    background: #0b0818;
    padding: 1;
}

/* Data Tables */
DataTable {
    background: transparent;
    color: #d1c9e8;
    height: 1fr;
    border: none;
}

DataTable > .datatable--header {
    background: #16102c;
    color: #facc15;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #352562;
    color: #ffffff;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #1c1436;
}

.section-title {
    color: #facc15;
    text-style: bold;
    border-bottom: solid #2c214c;
    margin-top: 1;
    margin-bottom: 1;
}

/* --------------------------------------------------------------------------
   Alerts Tab
   -------------------------------------------------------------------------- */

#alerts-action-bar {
    height: 1;
    margin-bottom: 1;
    align: left middle;
}

#alerts-summary-label {
    width: 1fr;
    color: #facc15;
}

#btn-recalc-alerts {
    margin-right: 1;
    background: #2e1d54;
    color: #facc15;
}

#btn-recalc-alerts:hover {
    background: #7c3aed;
    color: #fde047;
}

#btn-refresh-alerts {
    background: #18122c;
    color: #d1c9e8;
}

#btn-refresh-alerts:hover {
    color: #fde047;
}

#alerts-split-container {
    height: 1fr;
}

#alerts-table-box {
    width: 60%;
    height: 1fr;
    border: solid #2c214c;
    background: #0b0818;
    margin-right: 1;
}

#alerts-table-box:focus-within {
    border: solid #facc15;
}

#alert-detail-pane {
    width: 40%;
    height: 1fr;
    border: solid #2c214c;
    background: #0b0818;
    padding: 1;
}

/* --------------------------------------------------------------------------
   Reports Tab
   -------------------------------------------------------------------------- */

#reports-nav-bar {
    height: 1;
    margin-bottom: 1;
    align: left middle;
}

.rep-nav-btn {
    margin-right: 1;
    min-width: 8;
    height: 1;
    background: #18122c;
    color: #d1c9e8;
}

.rep-nav-btn:hover {
    color: #fde047;
}

.rep-nav-btn.-active {
    background: #7c3aed;
    color: #fde047;
    text-style: bold;
}

#reports-content-box {
    height: 1fr;
    border: solid #2c214c;
    background: #0b0818;
    padding: 1;
}

#traj-controls-row {
    height: 1;
    margin-bottom: 1;
    align: left middle;
}

#traj-input-sat {
    width: 26;
    height: 1;
    margin-right: 1;
    border: none;
    background: #120e24;
    color: #ffffff;
    padding: 0 1;
}

#traj-input-min {
    width: 14;
    height: 1;
    margin-right: 1;
    border: none;
    background: #120e24;
    color: #ffffff;
    padding: 0 1;
}

#btn-run-trajectory {
    background: #2e1d54;
    color: #facc15;
}

#btn-run-trajectory:hover {
    background: #7c3aed;
    color: #ffffff;
}

#traj-result-box {
    height: 1fr;
    padding-top: 1;
}

/* --------------------------------------------------------------------------
   Sync Tab
   -------------------------------------------------------------------------- */

#sync-controls-box {
    height: auto;
    border: solid #2c214c;
    background: #0b0818;
    padding: 1;
    margin-bottom: 1;
}

#sync-source-row {
    height: 1;
    align: left middle;
    margin-bottom: 1;
}

#select-sync-source {
    width: 40;
    height: 1;
    margin-right: 1;
    border: none;
    background: #120e24;
    color: #d1c9e8;
}

#btn-trigger-sync {
    background: #2e1d54;
    color: #facc15;
}

#btn-trigger-sync:hover {
    background: #7c3aed;
    color: #ffffff;
}

#sync-step-label {
    color: #c084fc;
    margin-bottom: 0;
}

#sync-progress-bar {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

#sync-richlog {
    height: 1fr;
    border: solid #2c214c;
    background: #06040c;
    padding: 1;
}

/* --------------------------------------------------------------------------
   SQL Shell Screen
   -------------------------------------------------------------------------- */

#shell-view-container {
    height: 1fr;
    padding: 0 1 1 1;
}

#shell-top-controls {
    height: auto;
    border: solid #2c214c;
    background: #0b0818;
    padding: 1;
    margin-bottom: 1;
}

#shell-quick-row {
    height: 1;
    align: left middle;
    margin-bottom: 1;
}

.shell-chip-btn {
    min-width: 6;
    height: 1;
    margin-right: 1;
    background: #18122c;
    color: #c084fc;
}

.shell-chip-btn:hover {
    background: #2a1f4a;
    color: #facc15;
}

#shell-input-row {
    height: 5;
    align: left middle;
}

#shell-query-input {
    width: 1fr;
    height: 5;
    border: solid #3b2c63;
    background: #120e24;
    color: #ffffff;
    margin-right: 1;
    padding: 0 1;
}

#shell-query-input:focus {
    background: #1c1538;
}

#btn-run-query {
    min-width: 6;
    height: 1;
    background: #2e1d54;
    color: #facc15;
}

#shell-output-controls {
    height: 1;
    align: left middle;
    margin-top: 1;
}

#shell-editor-hint {
    width: 1fr;
    color: #756999;
}

#btn-toggle-output {
    min-width: 14;
    height: 1;
    background: #18122c;
    color: #c084fc;
}

#btn-run-query:hover {
    background: #7c3aed;
    color: #ffffff;
}

#shell-status-banner {
    color: #756999;
    margin-top: 1;
}

#shell-results-box {
    height: 1fr;
    border: solid #2c214c;
    background: #0b0818;
    padding: 0;
}

#shell-results-table {
    height: 1fr;
}

#shell-raw-output {
    height: 1fr;
    padding: 1;
    display: none;
}

/* --------------------------------------------------------------------------
   Settings Screen
   -------------------------------------------------------------------------- */

#settings-view-container {
    height: 1fr;
    padding: 1 2;
    align: center top;
}

#settings-panel {
    width: 64;
    height: 1fr;
    border: solid #2c214c;
    background: #0b0818;
    padding: 1 2;
}

.settings-section-hdr {
    color: #facc15;
    text-style: bold;
    border-bottom: solid #2c214c;
    margin-top: 1;
    margin-bottom: 1;
}

.settings-row {
    height: 1;
    align: left middle;
    margin-bottom: 1;
}

.settings-label {
    width: 18;
    color: #756999;
}

.settings-input {
    width: 42;
    height: 1;
    border: none;
    background: #120e24;
    color: #ffffff;
    padding: 0 1;
}

#btn-save-settings {
    width: 100%;
    margin-top: 1;
    height: 1;
    background: #2e1d54;
    color: #facc15;
}

#btn-save-settings:hover {
    background: #7c3aed;
    color: #ffffff;
}

/* --------------------------------------------------------------------------
   Help Modal
   -------------------------------------------------------------------------- */

HelpModal {
    align: center middle;
}

#help-dialog-box {
    width: 60;
    height: auto;
    max-height: 80%;
    border: solid #9333ea;
    background: #0d0a1b;
    padding: 1 2;
}

#help-title {
    color: #facc15;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
    border-bottom: solid #2c214c;
}

#help-close-btn {
    margin-top: 1;
    width: 100%;
    height: 1;
    background: #18122c;
    color: #d1c9e8;
}

#help-close-btn:hover {
    color: #fde047;
}
